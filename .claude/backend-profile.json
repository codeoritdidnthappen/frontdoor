{
  "languages": {
    "src": "python",
    "tests": "python"
  },
  "default": "python",
  "concerns": [],
  "layers": {},
  "gates": {
    "typecheck": "python -m compileall -q src tests",
    "lint": "git diff --check",
    "test": "pytest",
    "build": "docker build -t frontdoor-server:backend-gate ."
  },
  "service": {
    "start": "gunicorn --bind 127.0.0.1:8080 --workers 1 --threads 2 --timeout 30 frontdoor_server.wsgi:app",
    "health": "/health",
    "port": 8080
  }
}
