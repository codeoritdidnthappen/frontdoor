# TICK-012 / D-020 / D-026. Copy to .env — never commit real keys.
# python -m frontdoor.storage verify loads .env from the current directory.
# Endpoint is the R2 account URL. Region is "auto" for R2.

FRONTDOOR_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
FRONTDOOR_S3_REGION=auto

# Loader and server. Must not be able to read the depth bucket.
FRONTDOOR_IMAGES_BUCKET=frontdoor-image
FRONTDOOR_IMAGES_ACCESS_KEY=
FRONTDOOR_IMAGES_SECRET_KEY=

# Evaluation harness only. Second credential, not a superset of the first
# stuffed into one client.
FRONTDOOR_DEPTH_BUCKET=frontdoor-depth
FRONTDOOR_DEPTH_ACCESS_KEY=
FRONTDOOR_DEPTH_SECRET_KEY=
