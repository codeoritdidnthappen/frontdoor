# TICK-012 / D-020 / D-026. Copy this file to .env in the repo root and fill it in.
# NEVER commit real keys -- .env is gitignored, this example is not.
# frontdoor.storage searches upward from the working directory for .env, so any
# command run from inside the checkout picks it up. Real environment variables win.

# Endpoint is the R2 account URL. Region is "auto" for R2.
FRONTDOOR_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
FRONTDOOR_S3_REGION=auto

# Loader and server. Must not be able to read the depth bucket.
FRONTDOOR_IMAGES_BUCKET=frontdoor-image
FRONTDOOR_IMAGES_ACCESS_KEY=
FRONTDOOR_IMAGES_SECRET_KEY=

# Evaluation harness only. Second credential, not a superset of the first
# stuffed into one client.
FRONTDOOR_DEPTH_BUCKET=frontdoor-depth
FRONTDOOR_DEPTH_ACCESS_KEY=
FRONTDOOR_DEPTH_SECRET_KEY=

# Server-to-Worker depth-ingest capability (D-039, TICK-249/TICK-250). The Worker owns
# the R2 binding; the Fly process has no R2 depth credential. Generate this secret
# locally and set the same value on Fly and the Worker. Do not reuse another key.
FRONTDOOR_DEPTH_INGEST_URL=https://frontdoor-depth-ingest.frontdoor-depth-ingest.workers.dev
FRONTDOOR_DEPTH_INGEST_KEY=

# Shared secret for POST /upload (TICK-029). The capture app sends it as the
# X-Frontdoor-Upload-Key header. Unset means the endpoint refuses everything --
# closed, never open. This grants ingest only; it is not an R2 credential.
FRONTDOOR_UPLOAD_KEY=

# Owner claims JSONL (TICK-259). Default data/claims.jsonl. Optional in-store
# codes map: {"place_id": "CODE"}. Unset codes file means that channel is off.
# FRONTDOOR_CLAIMS=data/claims.jsonl
# FRONTDOOR_CLAIM_CODES=data/claim_codes.json
