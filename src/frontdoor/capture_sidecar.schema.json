{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/codeoritdidnthappen/frontdoor/blob/main/src/frontdoor/capture_sidecar.schema.json",
  "title": "Capture sidecar",
  "description": "One record per capture, written by the capture app at the shutter press. Shape defined in ARCHITECTURE.md section 4. Records what was captured, never what was computed.",
  "type": "object",
  "properties": {
    "capture_id": { "type": "string", "minLength": 1 },
    "entrance_id": {
      "type": "string",
      "pattern": "^E-[0-9]{3}(?![\\s\\S])",
      "description": "Canonical entrance ID: E- followed by exactly three digits (NFC, no surrounding whitespace). Same rule as frontdoor.split.canonical_entrance_id. Anchored with (?![\\s\\S]) rather than $ so a trailing newline is rejected under both Python re and ECMA-262 (TICK-229)."
    },
    "captured_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z(?![\\s\\S])",
      "description": "UTC RFC 3339 timestamp. Z is required; offsets are rejected so capture time has one spelling. Format assertion is enabled in validate_sidecar (rfc3339-validator). Anchored with (?![\\s\\S]) rather than $ so a trailing newline is rejected under both Python re and ECMA-262 (TICK-229)."
    },
    "device_model": { "type": "string", "minLength": 1 },
    "lens": { "type": "string", "minLength": 1 },
    "image": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "required": ["path", "sha256", "width", "height"],
      "additionalProperties": false
    },
    "depth": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "required": ["path", "sha256"],
      "additionalProperties": false
    },
    "intrinsics": {
      "type": "object",
      "properties": {
        "fx": { "type": "number", "exclusiveMinimum": 0 },
        "fy": { "type": "number", "exclusiveMinimum": 0 },
        "cx": { "type": "number" },
        "cy": { "type": "number" }
      },
      "required": ["fx", "fy", "cx", "cy"],
      "additionalProperties": false
    },
    "gravity": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "card_placement": { "enum": ["vertical", "ground"] },
    "roi": {
      "type": "object",
      "properties": {
        "threshold_top": { "$ref": "#/$defs/point" },
        "threshold_bottom": { "$ref": "#/$defs/point" },
        "card_corners": {
          "type": "array",
          "items": { "$ref": "#/$defs/point" },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "required": ["threshold_top", "threshold_bottom", "card_corners"],
      "additionalProperties": false
    },
    "ground_truth": {
      "type": "object",
      "properties": {
        "rise_in": {
          "type": "number",
          "description": "Threshold rise in inches, read from the caliper at the entrance."
        },
        "instrument": { "type": "string", "minLength": 1 }
      },
      "required": ["rise_in", "instrument"],
      "additionalProperties": false
    },
    "conditions": {
      "type": "object",
      "properties": {
        "distance_m": { "type": "number", "exclusiveMinimum": 0 },
        "lighting": { "type": "string", "minLength": 1 },
        "surface": { "type": "string", "minLength": 1 },
        "occlusion": { "type": "string", "minLength": 1 }
      },
      "required": ["distance_m", "lighting", "surface", "occlusion"],
      "additionalProperties": false
    },
    "split": { "enum": ["dev", "calib", "sealed"] }
  },
  "required": [
    "capture_id",
    "entrance_id",
    "captured_at",
    "device_model",
    "lens",
    "image",
    "depth",
    "intrinsics",
    "gravity",
    "card_placement",
    "ground_truth",
    "conditions",
    "split"
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "description": "Lowercase SHA-256 hex digest (hashlib.sha256().hexdigest()). Uppercase is rejected so a hash has one spelling in the manifest. Anchored with (?![\\s\\S]) rather than $ so a trailing newline is rejected under both Python re and ECMA-262.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "point": {
      "description": "Pixel coordinates [x, y] in the full-resolution image.",
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2
    }
  }
}
